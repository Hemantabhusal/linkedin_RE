# Full LinkedIn browser cookie string copied from Request Headers -> Cookie
LINKEDIN_COOKIES=

# Use the exact browser user agent that created the session
LINKEDIN_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:148.0) Gecko/20100101 Firefox/148.0

# Optional curl_cffi impersonation target. Keep aligned with the session browser.
# Examples: firefox, chrome124, chrome136
LINKEDIN_IMPERSONATE=firefox

# MySQL settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Conservative worker settings
BATCH_SIZE=4
MAX_RETRIES=3
SCRAPE_DELAY_MIN_MS=20000
SCRAPE_DELAY_MAX_MS=45000
RATE_LIMIT_COOLDOWN_MS=180000
REQUEST_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
DEBUG_LINKEDIN=0
LOG_PAYLOAD_SAMPLES=1

